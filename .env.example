# Theme / Branding
NEXT_PUBLIC_THEME_LAYOUT=showroom
NEXT_PUBLIC_THEME_PALETTE=forest-green
NEXT_PUBLIC_BRAND_NAME="AutoParts Store"
NEXT_PUBLIC_LOGO_URL="/Logo.png"
NEXT_PUBLIC_APP_ICON="/icons/appIcon.png"

# Tenant
NEXT_PUBLIC_TENANT_NAME="baja-kits"
NEXT_PUBLIC_ASSETS_BASE_URL="https://zgnluljrtbddtwugakuf.supabase.co"

# Saleor GraphQL
NEXT_PUBLIC_API_URL="https://api-baja-kits.wsm-dev.com/graphql/"
NEXT_PUBLIC_SALEOR_CHANNEL="default-channel"

# Site URLs
# Use localhost for local dev, even if production uses a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"

# Search / PartsLogic (YMM)
NEXT_PUBLIC_SEARCH_URL="https://wsm-migrator-api.alphasquadit.com"
NEXT_PUBLIC_PARTSLOGIC_URL="https://pl-baja-kits.wsm-dev.com"

# next/image allowlist (optional)
# Comma-separated hostnames or URLs (https://cdn.example.com,images.example.com).
NEXT_PUBLIC_IMAGE_HOSTS=""


# Forms delivery
# If you forward /api/form-submission to webhooks, restrict which domains can be called.
ALLOWED_WEBHOOK_DOMAINS=""

# SMTP (optional)
# If set, form submissions will be emailed via SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
SMTP_TO="leads@example.com"
SMTP_REPLY_TO=""
# Optional prefix for email subjects, e.g. "[Storefront]"
EMAIL_SUBJECT_PREFIX=""

# If you set this, be aware it changes behavior across the app (not recommended for `yarn dev`).
NODE_ENV="production"

# PayPal (optional)
# Set to "production" for live payments, "sandbox" for testing.
NEXT_PUBLIC_PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_APP_URL="https://paypal-app-url.com"
